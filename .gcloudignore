# .gcloudignore - Files to exclude when deploying to GCP
# [2025-01-27] Created for GCP deployment

# Dependencies
node_modules/
**/node_modules/

# Build outputs
.next/
dist/
build/
*.log

# Environment files
.env
.env.local
.env.*.local
*.env

# Git files
.git/
.gitignore
.gitattributes

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Test files
test-results/
playwright-report/
coverage/
*.test.js
*.test.ts
*.spec.js
*.spec.ts
tests/
**/tests/

# Documentation
docs/
*.md
!README.md

# Docker files (not needed in deployment context)
docker-compose.yml
Dockerfile.dev

# CI/CD configs (separate from Cloud Build)
.github/
.gitlab-ci.yml

# Local development files
.vscode/
.idea/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
tmp/
temp/
*.tmp

# Database files
*.sqlite
*.db

# Prototype files (not used in production)
prototype/

# Archive files
*.zip
*.tar.gz
*.rar

# Design files
*.psd
*.ai
*.sketch

# E2E test files
e2e/
playwright.config.ts

