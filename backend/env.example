# Backend environment template 
#
# 将此文件复制为 .env 并替换占位值：
#   cp env.example .env

NODE_ENV=development
PORT=3001

# PostgreSQL / Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/suvernireplus
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=suvernireplus

# JWT
JWT_SECRET=please_replace_with_strong_secret_value
JWT_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Application
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Email Service (SMTP) - 邮件服务配置
# 用于发送密码重置邮件、订单确认邮件等
EMAIL_PROVIDER=nodemailer
EMAIL_FROM=noreply@suvernireplus.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Optional services
REDIS_HOST=localhost
REDIS_PORT=6379
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=suvernire-plus-uploads
ALIYUN_OSS_REGION=oss-us-east-1
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=suvernire-plus

# Logging / Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info

# Offline Orders
OFFLINE_ORDER_MAX_FILES=10
OFFLINE_ORDER_MAX_FILE_MB=50

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

