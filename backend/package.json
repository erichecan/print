{
  "name": "suvernire-plus-backend",
  "version": "1.0.0",
  "description": "Backend API for suvernire plus custom merchandise e-commerce platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:reset": "npm run db:migrate:undo:all && npm run db:migrate && npm run db:seed",
    "prisma:generate": "prisma generate --schema=../prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=../prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=../prisma/schema.prisma",
    "migrate:deploy": "node scripts/run-migrations.js"
  },
  "keywords": [
    "ecommerce",
    "custom-printing",
    "api",
    "nodejs",
    "express"
  ],
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^7.101.0",
    "@paypal/checkout-server-sdk": "^1.0.3",
    "@prisma/client": "^5.8.1",
    "ali-oss": "^6.18.1",
    "aws-sdk": "^2.1496.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.13.0",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.0",
    "sharp": "^0.33.1",
    "stripe": "^14.7.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "prisma": "^5.8.1",
    "sequelize-cli": "^6.6.2",
    "supertest": "^6.3.3"
  },
  "_devDependenciesNote": "后端开发工具保持与现有代码兼容 [2025-11-10 12:40:00]",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
