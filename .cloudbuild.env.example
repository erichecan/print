# Cloud Build substitution variables example
# Copy this file and set actual values in Cloud Build triggers or gcloud commands
# GCP deployment configuration template

# GCP Project Configuration
PROJECT_ID=your-gcp-project-id
_REGION=us-central1
_ARTIFACT_REGISTRY=print-main

# Service Names
_BACKEND_SERVICE_NAME=print-main-backend
_FRONTEND_SERVICE_NAME=print-main-frontend

# Cloud SQL Configuration
_DB_INSTANCE_NAME=print-main-db
_DB_NAME=suvernireplus

# Service URLs (set after first deployment)
_BACKEND_URL=https://print-main-backend-xxxxx-uc.a.run.app
_FRONTEND_URL=https://print-main-frontend-xxxxx-uc.a.run.app

