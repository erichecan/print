{
  "name": "print-ecom-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "backend"
  ],
  "scripts": {
    "dev": "echo use per-app dev",
    "build": "echo use per-app build",
    "lint": "echo use per-app lint",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "crawl:emojis:animals": "ts-node scripts/crawler/apify/emojis-animals.ts",
    "crawl:freepik": "ts-node scripts/crawler/freepik/freepik-stock.ts",
    "ingest:upload": "ts-node scripts/ingest/upload-to-gcs.ts",
    "ingest:db": "ts-node scripts/ingest/import-artworks.ts",
    "db:seed:pricing": "node backend/scripts/seed-size-pricing.js",
    "db:seed:fees": "node backend/scripts/seed-offline-order-fees.js",
    "check:art-assets": "node scripts/check-art-assets.js"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "cross-env TS_NODE_PROJECT=tsconfig.seed.json ts-node --transpile-only prisma/seed.ts"
  }
}