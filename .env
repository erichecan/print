NODE_ENV=development
PORT=3001

# PostgreSQL / Prisma (Local → Cloud SQL dev via Auth Proxy)
# 说明（本地开发）：
# - 请先启动 Cloud SQL Auth Proxy 连接到 print1600 实例，例如：
#   cloud-sql-proxy print-482914:us-central1:print1600 --port=5433
# - 然后把下面的 POSTGRES_PASSWORD_HERE 替换为 Cloud SQL 中 postgres 或应用账号的真实密码
# - 数据库指向开发库 suvernireplus_dev（已在实例 print1600 中创建）
DATABASE_URL=postgresql://postgres:c6g9.ik%7B%5B%23%24T%2CX%22%3C@127.0.0.1:5433/suvernireplus
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=c6g9.ik{[#$T,X"<
DB_NAME=suvernireplus

# JWT
JWT_SECRET=please_replace_with_strong_secret_value
JWT_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Application
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Optional services
REDIS_HOST=localhost
REDIS_PORT=6379

# Logging / Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
